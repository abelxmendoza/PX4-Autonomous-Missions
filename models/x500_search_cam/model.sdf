<?xml version="1.0" encoding="UTF-8"?>
<!-- x500 with one downward-facing camera, for the search-and-find world.

     Same idea as PX4's stock x500_mono_cam_down (airframe 4014), but the camera is a
     first-class link defined inline, like the stereo pair in x500_lidar_2d: that is the
     form proven to render on this host (BUG-017; consumers also need GZ_IP=127.0.0.1).

     Mounted under the body (z = -0.05 m) and pitched +90 deg about y, so the optical axis
     (+x of the sensor) points straight down (-z). Near clip 0.1 m keeps the drone's own
     arms out of the image. Intrinsics match the forward cameras: 640x480, hfov 1.74 rad.
     At 8 m altitude the footprint is about 19 x 14 m and a 1 m marker is about 34 px wide
     (focal length ~ 275 px), enough for ArUco 4x4 detection.

     Gazebo topic (PX4 instance 0):
       /world/search_field/model/x500_search_cam_0/link/camera_down_link/sensor/down_imager/image -->
<sdf version='1.9'>
  <model name='x500_search_cam'>
    <self_collide>false</self_collide>
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <link name="camera_down_link">
      <pose>0 0 -0.05 0 1.5707963 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <visual name="camera_down_housing">
        <geometry><box><size>0.02 0.04 0.04</size></box></geometry>
      </visual>
      <sensor name="down_imager" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>80</far>
          </clip>
          <!-- All bits except 2: the tracking aids below (flags = 2) are invisible to this
               camera, so they can never hide a target from the search. -->
          <visibility_mask>4294967293</visibility_mask>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <!-- Tracking aids so the drone is easy to follow in the Gazebo window: a translucent
         amber cage around the airframe and a beacon above it. Visual only (no collision,
         negligible mass) and flagged 2, which the downward camera's visibility_mask
         excludes. -->
    <link name="tracking_aids_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-7</ixx><iyy>1e-7</iyy><izz>1e-7</izz></inertia>
      </inertial>
      <visual name="geo_cage">
        <pose>0 0 0.2 0 0 0</pose>
        <geometry><box><size>2.2 2.2 1.2</size></box></geometry>
        <transparency>0.75</transparency>
        <cast_shadows>false</cast_shadows>
        <visibility_flags>2</visibility_flags>
        <material>
          <ambient>1.0 0.71 0.28 1</ambient><diffuse>1.0 0.71 0.28 1</diffuse>
          <emissive>0.6 0.35 0.05 1</emissive>
        </material>
      </visual>
      <visual name="beacon">
        <pose>0 0 1.6 0 0 0</pose>
        <geometry><sphere><radius>0.35</radius></sphere></geometry>
        <cast_shadows>false</cast_shadows>
        <visibility_flags>2</visibility_flags>
        <material>
          <ambient>1.0 0.71 0.28 1</ambient><diffuse>1.0 0.71 0.28 1</diffuse>
          <emissive>1.0 0.6 0.1 1</emissive>
        </material>
      </visual>
      <visual name="beacon_mast">
        <pose>0 0 1.05 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.9</length></cylinder></geometry>
        <cast_shadows>false</cast_shadows>
        <visibility_flags>2</visibility_flags>
        <material><ambient>1.0 0.71 0.28 1</ambient><diffuse>1.0 0.71 0.28 1</diffuse></material>
      </visual>
    </link>
    <joint name="TrackingAidsJoint" type="fixed">
      <parent>base_link</parent>
      <child>tracking_aids_link</child>
    </joint>

    <joint name="CameraDownJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_down_link</child>
    </joint>
  </model>
</sdf>
