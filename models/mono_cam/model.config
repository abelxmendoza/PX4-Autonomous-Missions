<?xml version="1.0"?>
<model>
  <name>mono_cam</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Abel Mendoza</name>
    <email>abelxmendoza@gmail.com</email>
  </author>
  <description>Left camera of the x500_lidar_2d stereo pair. Same
    640x480 / 10 Hz / R8G8B8 settings as mono_cam_right so block-matching
    stereo stays valid. Overrides PX4's stock 1280x960@30Hz mono_cam when
    this models/ directory is on GZ_SIM_RESOURCE_PATH.</description>
</model>
