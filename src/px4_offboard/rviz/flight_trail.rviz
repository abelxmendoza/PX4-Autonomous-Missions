Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /FlightTrail1
        - /FlightPath1
      Splitter Ratio: 0.5
    Tree Height: 400
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: FlightTrail
      Topic:
        Value: /px4_offboard/flight_marker
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: FlightPath
      Topic:
        Value: /px4_offboard/flight_path
      Line Style: Billboards
      Color: 25; 255; 255
  Global Options:
    Fixed Frame: map
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 60
      Name: Current View
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1200
