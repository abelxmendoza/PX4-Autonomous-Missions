<?xml version="1.0" ?>
<!--
  Gazebo Harmonic obstacle world for PX4 SITL obstacle avoidance.
  Origin: 47.397742°N, 8.545594°E (PX4 Gazebo default — Zurich)

  Obstacle layout (ENU, meters from spawn):
    OB1 — (east=-6, north=10) — 3×3×11.5m — red    (taller than the fence ceiling — climb is not an option)
    OB2 — (east=10, north=10) — 3×3×6m    — orange (off to the side, rarely on the flight path)
    OB3 — (east=-8, north=24) — 5×3×4m    — green  (widened — tighter corridor with OB4)
    OB4 — (east=6, north=24) — 3×2×5m     — blue   (widened — tighter corridor with OB3)
    OB5 — (east=0, north=38) — 5×3×11.5m  — purple (taller than the fence ceiling — climb is not an option)

  Usage:
    Place this file in PX4-Autopilot/Tools/simulation/gz/worlds/
    or export GZ_SIM_RESOURCE_PATH to this directory, then:
      PX4_GZ_WORLD=obstacle_world make px4_sitl gz_x500
-->
<sdf version="1.9">
  <world name="obstacle_world">

    <!--
      NO plugin declarations here — all world-system plugins are provided
      by PX4's server.config (GZ_SIM_SERVER_CONFIG_PATH) and applied to
      every world via entity_name="*". Declaring them here too creates
      duplicate registrations that break model-path sensor topics and
      prevent sensor_baro / sensor_mag from publishing to uORB.

      server.config provides:
        Physics, UserCommands, SceneBroadcaster, Sensors (ogre2),
        Imu, AirPressure, NavSat, Magnetometer, Contact, AirSpeed
    -->

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <ambient>0.72 0.76 0.82 1</ambient>
      <background>0.48 0.68 0.88 1</background>
      <sky/>
      <fog>
        <type>linear</type>
        <color>0.72 0.80 0.88 1</color>
        <start>140</start>
        <end>300</end>
        <density>0.002</density>
      </fog>
    </scene>

    <!-- GPS origin — must match PX4 SITL home position -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>47.397742</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>488.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground plane ─────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 300</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>300 300</size></plane>
          </geometry>
          <material>
            <ambient>0.45 0.62 0.37 1</ambient>
            <diffuse>0.45 0.62 0.37 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Flight-training course surface and 5 m reference grid ──
         These are visual-only so they do not alter vehicle dynamics. -->
    <model name="training_course">
      <static>true</static>
      <link name="course_markings">
        <visual name="course_surface">
          <pose>0 25 0.012 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>36 60 0.02</size></box></geometry>
          <material>
            <ambient>0.20 0.25 0.27 1</ambient>
            <diffuse>0.24 0.29 0.31 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>

        <!-- East/west course boundaries at +-18 m; both launch pads sit
             comfortably inside the front of the course. -->
        <visual name="boundary_west">
          <pose>-18 25 0.03 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.18 60 0.025</size></box></geometry>
          <material><ambient>0.95 0.82 0.10 1</ambient><diffuse>0.95 0.82 0.10 1</diffuse></material>
        </visual>
        <visual name="boundary_east">
          <pose>18 25 0.03 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.18 60 0.025</size></box></geometry>
          <material><ambient>0.95 0.82 0.10 1</ambient><diffuse>0.95 0.82 0.10 1</diffuse></material>
        </visual>

        <!-- Longitudinal grid lines at east=-10,-5,0,5,10 m. -->
        <visual name="grid_e_m10"><pose>-10 25 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.055 60 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>
        <visual name="grid_e_m5"><pose>-5 25 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.055 60 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>
        <visual name="grid_e_0"><pose>0 25 0.029 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.12 60 0.024</size></box></geometry><material><ambient>0.88 0.90 0.92 1</ambient><diffuse>0.88 0.90 0.92 1</diffuse></material></visual>
        <visual name="grid_e_5"><pose>5 25 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.055 60 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>
        <visual name="grid_e_10"><pose>10 25 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.055 60 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>

        <!-- Cross-course grid lines every 5 m north of spawn. -->
        <visual name="grid_n_5"><pose>0 5 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>30 0.055 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>
        <visual name="grid_n_10"><pose>0 10 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>30 0.055 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>
        <visual name="grid_n_15"><pose>0 15 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>30 0.055 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>
        <visual name="grid_n_20"><pose>0 20 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>30 0.055 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>
        <visual name="grid_n_25"><pose>0 25 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>30 0.055 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>
        <visual name="grid_n_30"><pose>0 30 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>30 0.055 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>
        <visual name="grid_n_35"><pose>0 35 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>30 0.055 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>
        <visual name="grid_n_40"><pose>0 40 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>30 0.055 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>
        <visual name="grid_n_45"><pose>0 45 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>30 0.055 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>
        <visual name="grid_n_50"><pose>0 50 0.028 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>30 0.055 0.022</size></box></geometry><material><ambient>0.55 0.61 0.63 1</ambient><diffuse>0.55 0.61 0.63 1</diffuse></material></visual>

        <!-- High-contrast launch pad (N=0 E=-3) and landing pad (N=50). -->
        <visual name="launch_pad">
          <pose>-3 0 0.045 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><cylinder><radius>2.5</radius><length>0.035</length></cylinder></geometry>
          <material><ambient>0.08 0.10 0.12 1</ambient><diffuse>0.08 0.10 0.12 1</diffuse></material>
        </visual>
        <visual name="launch_h_crossbar"><pose>-3 0 0.07 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.7 0.28 0.025</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="launch_h_left"><pose>-3.7 0 0.07 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.28 1.8 0.025</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="launch_h_right"><pose>-2.3 0 0.07 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.28 1.8 0.025</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <!-- Second launch pad (px4_2 home, N=0 E=7), matching the
             original dark disc and white H markings. -->
        <visual name="launch_pad_2">
          <pose>7 0 0.045 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><cylinder><radius>2.5</radius><length>0.035</length></cylinder></geometry>
          <material><ambient>0.08 0.10 0.12 1</ambient><diffuse>0.08 0.10 0.12 1</diffuse></material>
        </visual>
        <visual name="launch_h2_crossbar"><pose>7 0 0.07 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.7 0.28 0.025</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="launch_h2_left"><pose>6.3 0 0.07 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.28 1.8 0.025</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="launch_h2_right"><pose>7.7 0 0.07 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.28 1.8 0.025</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>

        <visual name="landing_pad">
          <pose>0 50 0.045 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><cylinder><radius>2.5</radius><length>0.035</length></cylinder></geometry>
          <material><ambient>0.08 0.10 0.12 1</ambient><diffuse>0.08 0.10 0.12 1</diffuse></material>
        </visual>
        <visual name="landing_ring">
          <pose>0 50 0.055 0 0 0</pose><cast_shadows>false</cast_shadows>
          <geometry><cylinder><radius>2.72</radius><length>0.012</length></cylinder></geometry>
          <material>
            <ambient>0.95 0.72 0.08 1</ambient>
            <diffuse>0.95 0.72 0.08 1</diffuse>
            <emissive>0.35 0.22 0.02 1</emissive>
          </material>
        </visual>
        <visual name="landing_h_crossbar"><pose>0 50 0.07 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.7 0.28 0.025</size></box></geometry><material><ambient>0.95 0.82 0.10 1</ambient><diffuse>0.95 0.82 0.10 1</diffuse></material></visual>
        <visual name="landing_h_left"><pose>-0.7 50 0.07 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.28 1.8 0.025</size></box></geometry><material><ambient>0.95 0.82 0.10 1</ambient><diffuse>0.95 0.82 0.10 1</diffuse></material></visual>
        <visual name="landing_h_right"><pose>0.7 50 0.07 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>0.28 1.8 0.025</size></box></geometry><material><ambient>0.95 0.82 0.10 1</ambient><diffuse>0.95 0.82 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Safety beacons mark the course perimeter without adding collisions. -->
    <model name="course_beacons">
      <static>true</static>
      <link name="beacons">
        <visual name="west_10"><pose>-16 10 0.65 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.3</length></cylinder></geometry><material><ambient>1 0.35 0.02 1</ambient><diffuse>1 0.35 0.02 1</diffuse><emissive>0.3 0.08 0 1</emissive></material></visual>
        <visual name="east_10"><pose>16 10 0.65 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.3</length></cylinder></geometry><material><ambient>1 0.35 0.02 1</ambient><diffuse>1 0.35 0.02 1</diffuse><emissive>0.3 0.08 0 1</emissive></material></visual>
        <visual name="west_25"><pose>-16 25 0.65 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.3</length></cylinder></geometry><material><ambient>1 0.35 0.02 1</ambient><diffuse>1 0.35 0.02 1</diffuse><emissive>0.3 0.08 0 1</emissive></material></visual>
        <visual name="east_25"><pose>16 25 0.65 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.3</length></cylinder></geometry><material><ambient>1 0.35 0.02 1</ambient><diffuse>1 0.35 0.02 1</diffuse><emissive>0.3 0.08 0 1</emissive></material></visual>
        <visual name="west_40"><pose>-16 40 0.65 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.3</length></cylinder></geometry><material><ambient>1 0.35 0.02 1</ambient><diffuse>1 0.35 0.02 1</diffuse><emissive>0.3 0.08 0 1</emissive></material></visual>
        <visual name="east_40"><pose>16 40 0.65 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>1.3</length></cylinder></geometry><material><ambient>1 0.35 0.02 1</ambient><diffuse>1 0.35 0.02 1</diffuse><emissive>0.3 0.08 0 1</emissive></material></visual>
      </link>
    </model>

    <!-- ── OB1: Red building — east=-6m, north=10m, 11.5m tall — taller than the fence ceiling ── -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>-6 10 5.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 3 11.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 3 11.5</size></box></geometry>
          <material>
            <ambient>0.85 0.15 0.15 1</ambient>
            <diffuse>0.85 0.15 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <visual name="roof_marker">
          <pose>0 0 5.45 0 0 0</pose>
          <geometry><box><size>3.18 3.18 0.12</size></box></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── OB2: Orange tower — east=10m, north=10m, 6m tall ── -->
    <model name="obstacle_2">
      <static>true</static>
      <pose>10 10 3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 3 6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 3 6</size></box></geometry>
          <material>
            <ambient>0.9 0.5 0.05 1</ambient>
            <diffuse>0.9 0.5 0.05 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <visual name="roof_marker">
          <pose>0 0 2.03 0 0 0</pose>
          <geometry><box><size>4.18 3.18 0.12</size></box></geometry>
          <material><ambient>0.98 0.98 0.98 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── OB3: Green block — east=-8m, north=24m, 4m tall — widened, tighter corridor with OB4 ── -->
    <model name="obstacle_3">
      <static>true</static>
      <pose>-8 24 2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5 3 4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 3 4</size></box></geometry>
          <material>
            <ambient>0.15 0.65 0.15 1</ambient>
            <diffuse>0.15 0.65 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <visual name="roof_marker">
          <pose>0 0 2.53 0 0 0</pose>
          <geometry><box><size>2.18 2.18 0.12</size></box></geometry>
          <material><ambient>0.98 0.98 0.98 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── OB4: Blue pillar — east=6m, north=24m, 5m tall — widened, tighter corridor with OB3 ── -->
    <model name="obstacle_4">
      <static>true</static>
      <pose>6 24 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3 2 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3 2 5</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.85 1</ambient>
            <diffuse>0.15 0.15 0.85 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <visual name="roof_marker">
          <pose>0 0 2.53 0 0 0</pose>
          <geometry><box><size>2.18 2.18 0.12</size></box></geometry>
          <material><ambient>0.98 0.98 0.98 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── OB5: Purple wall — east=0m, north=38m, 11.5m tall — taller than the fence ceiling ── -->
    <model name="obstacle_5">
      <static>true</static>
      <pose>0 38 5.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5 3 11.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 3 11.5</size></box></geometry>
          <material>
            <ambient>0.65 0.0 0.75 1</ambient>
            <diffuse>0.65 0.0 0.75 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <visual name="roof_marker">
          <pose>0 0 5.45 0 0 0</pose>
          <geometry><box><size>5.18 3.18 0.12</size></box></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── GPS-denied visualization (NED N[15.5,31.5] E[-8,8]).
         Gazebo pose is ENU: x=east, y=north, z=up. Translucent prism only —
         does not disable NavSat/EKF GPS (that is Pass 2). ── -->
    <model name="gps_denied_zone">
      <static>true</static>
      <pose>0 23.5 6 0 0 0</pose>
      <link name="link">
        <visual name="volume">
          <transparency>0.82</transparency>
          <geometry><box><size>16 16 12</size></box></geometry>
          <material>
            <ambient>0.15 0.85 1 0.18</ambient>
            <diffuse>0.15 0.85 1 0.18</diffuse>
            <emissive>0.03 0.16 0.20 1</emissive>
            <specular>0.2 0.05 0.25 0.1</specular>
          </material>
        </visual>
        <visual name="outline">
          <transparency>0.62</transparency>
          <geometry><box><size>16.18 16.18 12.18</size></box></geometry>
          <material>
            <ambient>0.10 0.95 1 0.38</ambient>
            <diffuse>0.10 0.95 1 0.38</diffuse>
            <emissive>0.04 0.22 0.24 1</emissive>
            <specular>0.1 0.3 0.3 0.1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Distant visual landmarks add depth and orientation cues. ── -->
    <model name="landscape_landmarks">
      <static>true</static>
      <link name="landmarks">
        <!-- Tree clusters stay well outside the geofenced training corridor. -->
        <visual name="tree_w1_trunk"><pose>-28 8 1.1 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>2.2</length></cylinder></geometry><material><ambient>0.30 0.16 0.07 1</ambient><diffuse>0.30 0.16 0.07 1</diffuse></material></visual>
        <visual name="tree_w1_crown"><pose>-28 8 3.0 0 0 0</pose><geometry><sphere><radius>1.8</radius></sphere></geometry><material><ambient>0.12 0.38 0.12 1</ambient><diffuse>0.12 0.38 0.12 1</diffuse></material></visual>
        <visual name="tree_w2_trunk"><pose>-25 31 1.3 0 0 0</pose><geometry><cylinder><radius>0.4</radius><length>2.6</length></cylinder></geometry><material><ambient>0.30 0.16 0.07 1</ambient><diffuse>0.30 0.16 0.07 1</diffuse></material></visual>
        <visual name="tree_w2_crown"><pose>-25 31 3.5 0 0 0</pose><geometry><sphere><radius>2.1</radius></sphere></geometry><material><ambient>0.10 0.34 0.10 1</ambient><diffuse>0.10 0.34 0.10 1</diffuse></material></visual>
